<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- 上半部分：背景图与文字 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/campus_background"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:text="@string/welcome_message"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 下半部分：2x2 网格 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/green"
        android:columnCount="2"
        android:rowCount="2">

        <ImageButton
            android:id="@+id/btnFacilities"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/button_selector"
            android:contentDescription="Facilities"
            android:scaleType="fitCenter"
            android:src="@drawable/img_btn_facilities" />

        <ImageButton
            android:id="@+id/btnEvents"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/button_selector"
            android:contentDescription="Events"
            android:scaleType="fitCenter"
            android:src="@drawable/img_btn_events" />

        <ImageButton
            android:id="@+id/btnClubs"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/button_selector"
            android:contentDescription="Clubs"
            android:scaleType="fitCenter"
            android:src="@drawable/img_btn_clubs" />

        <ImageButton
            android:id="@+id/btnSupport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/button_selector"
            android:contentDescription="Support"
            android:scaleType="fitCenter"
            android:src="@drawable/img_btn_support" />

    </GridLayout>
</LinearLayout>